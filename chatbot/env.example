# --- LLM ---
# Proveedor
LLM_PROVIDER=groq
# Nombre del modelo (proveedor con tool calling: en Groq usar la familia openai/gpt-oss-*)
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=


# --- Integraciones ---
# API del backend NestJS que el chatbot consumira (tools de alta/modif/baja)
BACKEND_API_URL=http://localhost:3000/api

# --- Servidor ---
CHATBOT_PORT=8100
CORS_ORIGIN=http://localhost:5173

# --- RAG (opcional) ---
#EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
#RAG_TOP_K=4

