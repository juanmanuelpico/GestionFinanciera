# Copiar este archivo a .env antes de levantar el proyecto:
#   cp env.example .env

# PostgreSQL
POSTGRES_USER=finanzas
POSTGRES_PASSWORD=finanzas_dev
POSTGRES_DB=gestion_financiera
POSTGRES_PORT=5433

# Puertos host
API_PORT=3000
WEB_PORT=5173
ADMINER_PORT=8080
CHATBOT_PORT=8100

# Backend
NODE_ENV=development
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@finanzas.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Administrador

# Frontend
VITE_API_URL=http://localhost:3000/api
# URL pública del chatbot (desde el navegador; en Docker usa localhost del host)
VITE_CHATBOT_URL=http://localhost:8100

# Chatbot (LangChain). LLM_PROVIDER: ollama (local) o groq (cloud)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
GROQ_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

